# Railway preenche DATABASE_URL sozinho ao ligar o Postgres ao serviço
DATABASE_URL=postgresql://usuario:senha@host:5432/railway

# Login da tela /admin (use uma senha longa)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-longa

# Domínios do site que podem enviar o formulário e conversar com o agente, separados por vírgula, sem barra no final
ALLOWED_ORIGINS=https://www.seudominio.com.br

# Chave da API da Anthropic, para o agente de chat (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: só mude se quiser usar outro modelo. Lista atual em
# https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Twilio (WhatsApp): console.twilio.com > Account Info > Account SID e Auth Token
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Número que envia as mensagens, com prefixo whatsapp:. No Sandbox de teste é
# whatsapp:+14155238886. Depois que o WhatsApp Business for aprovado pra produção,
# troca pelo número definitivo.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Opcional: seu WhatsApp (com DDI, ex: 5511999998888), pra receber um aviso a cada
# inscrição nova. Deixe em branco se não quiser esse aviso.
TWILIO_OWNER_WHATSAPP=

# SIDs dos Content Templates aprovados no console da Twilio (Messaging > Templates).
# Obrigatórios: sem eles a mensagem business-initiated no WhatsApp não sai (erro
# "ContentSid Required"). Copie o SID (começa com HX) de cada template criado lá.
TWILIO_CONFIRM_TEMPLATE_SID=HX...
TWILIO_OWNER_TEMPLATE_SID=HX...
